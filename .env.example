# Copy to .env and fill in. .env is gitignored; never commit real values.

# Client (Vite). Both come from Supabase > Project Settings > API.
# The anon key is public by design: it ships in the browser bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Edge function (supabase/functions/analyze-career-path). Vite does not expose
# these to the browser, and the deployed function does not read this file: set
# them on Supabase with
#   supabase secrets set GEMINI_API_KEY=your-gemini-api-key
GEMINI_API_KEY=your-gemini-api-key
# Optional. Defaults to gemini-4-argon, which needs a billed key; gemini-3.8-flash runs on the free tier.
GEMINI_MODEL=gemini-4-argon
